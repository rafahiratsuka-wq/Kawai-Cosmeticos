# Copie para .env e preencha. NUNCA suba o .env para o Git.
PORT=3000
# URL pública do site. Em produção, use https. Em testes locais, use um túnel (ex.: ngrok) para o webhook funcionar.
BASE_URL=http://localhost:3000

# ---- Mercado Pago (painel de desenvolvedores > Suas integrações) ----
MP_ACCESS_TOKEN=
# Chave secreta do webhook (Suas integrações > Webhooks). Se vazio, a assinatura não é validada (só use em teste).
MP_WEBHOOK_SECRET=

# ---- Correios (CWS: cws.correios.com.br > Gestão de acesso a APIs) ----
# As APIs de preço e prazo exigem contrato ativo e cartão de postagem. Sem estes campos, o frete é SIMULADO.
CORREIOS_USUARIO=
CORREIOS_CODIGO_ACESSO=
CORREIOS_CARTAO=
CORREIOS_CONTRATO=
CORREIOS_DR=
# CEP de onde a loja despacha (somente números)
CEP_ORIGEM=01503001
# Códigos dos serviços no seu contrato (confira no CWS)
CORREIOS_COD_PAC=03298
CORREIOS_COD_SEDEX=03220
